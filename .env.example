# Node.js 24. Local database and uploaded files need persistent disk.
# TIBB_ names are retained for compatibility with the source application.
TIBB_DATABASE_PATH=./data/slowlax.sqlite
TIBB_UPLOAD_DIR=./data/uploads
APP_URL=http://localhost:3000
# Set to the production HTTPS origin after your domain is connected.
SITE_URL=https://slowlax.se
# Optional public verification values from Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Required on Vercel: a dedicated Turso/libSQL database for this installation.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional Supabase/PostgreSQL migration. Keep both switches false until the
# schema, existing content and admin account have been verified in Supabase.
SUPABASE_DATABASE_ENABLED=false
SUPABASE_AUTH_ENABLED=false
DATABASE_URL=
# Optional trusted root certificate from Supabase Database settings (PEM, \n allowed).
SUPABASE_DB_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only administration key. Never prefix it or DATABASE_URL with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional one-time binding of an existing admin to a verified Supabase user UUID.
SUPABASE_ADMIN_USER_ID=
# Private Vercel Blob store for course and group material.
# Vercel supplies OIDC automatically; do not copy its temporary token here.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Optional Blob credential outside Vercel (also needs BLOB_WEBHOOK_PUBLIC_KEY).
BLOB_READ_WRITE_TOKEN=
# Initial /setup token: at least 32 random characters. Remove after admin setup.
SETUP_TOKEN=
# Optional course purchases. Existing checkout supports SEK only.
# Course endpoint: /api/kurser/webhook. See docs/course-purchases-setup.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional recurring memberships. Endpoint: /api/medlemskap/webhook.
MEMBERSHIP_STRIPE_WEBHOOK_SECRET=
MEMBERSHIP_STRIPE_PORTAL_CONFIGURATION_ID=
# Optional standalone Rening purchases. Endpoint: /api/rening/webhook.
# Uses STRIPE_SECRET_KEY; activate offers and terms in Admin -> Rening.
RENING_STRIPE_WEBHOOK_SECRET=
# Email verification and password recovery: use a verified Resend sender.
# Never prefix server secrets with NEXT_PUBLIC_. APP_URL supplies trusted links.
RESEND_API_KEY=
EMAIL_FROM=
# Optional automatic newsletter invitations for NEW students after verification.
# Configure form/tag and enable under Admin -> Nyhetsbrev. Never NEXT_PUBLIC_.
KIT_API_KEY=
# Protects GET /api/cron/kit-newsletter for scheduled retries (Bearer token).
CRON_SECRET=
# Only enable behind a proxy you operate that replaces x-forwarded-for.
# Vercel trusts its own IP header automatically.
TRUST_PROXY=
